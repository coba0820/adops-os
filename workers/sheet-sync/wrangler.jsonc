{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // AdOps OS: スプレッドシート同期の定時実行用 Worker
  // Cloudflare Pages の関数は Cron Trigger を使えないため、別 Worker として動かす。
  "name": "adops-os-sheet-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-26",
  // Pages と同じ D1 を使う
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adops-os-db",
      "database_id": "3a02bd00-7644-4046-9f80-d61fc9813ead"
    }
  ],
  // 実行時刻（UTC）。"0 3 * * *" = 毎日 JST 12:00
  // 変更したら npm run worker:sheet-sync:deploy で反映し、
  // src/lib/sheet-sync.ts の SCHEDULED_SYNC_HOUR_JST も合わせる（「同期未実行」警告の判定に使う）
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
